# Standalone CMakeLists.txt for AOCL-DLP Classic Examples
# This file is designed to work with an installed AOCL-DLP library
# Can be used standalone or as a subdirectory

# Only set project and find dependencies if this is the top-level project
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    cmake_minimum_required(VERSION @CMAKE_MINIMUM_REQUIRED_VERSION@)
    project(AOCL_DLP_Classic_Examples VERSION @PROJECT_VERSION@ LANGUAGES C CXX)

    # Option to choose between static and shared library
    option(USE_STATIC_LIBRARY "Link with static AOCL-DLP library" OFF)

    # Find the installed AOCL-DLP package
    find_package(AoclDlp REQUIRED)

endif()

# Set source directory
set(EXAMPLE_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src")

# List of example source files
set(EXAMPLE_SOURCES
    simple_gemm_f32.c
    multi_instance_gemm_f32.c
    multi_instance_gemm_u8s8.c
    simple_gemm_bf16.c
    simple_gemm_s8.c
    simple_gemm_with_bias.c
    simple_gemm_with_relu.c
    matrix_reorder.c
    matrix_unreorder.c
    matrix_reorder_reference.c
    batch_gemm.c
    quantization.c
    simple_gemm_s8_sym_quant.c
    simple_gemm_bf16s8.c
    simple_gemm_bf16s4.c
    simple_gemm_bf16u4.c
    simple_gemm_f32s8.c
    post_ops_combinations.c
    eltwise_ops.c
    version.c
)

# Choose library target based on user preference
if(USE_STATIC_LIBRARY)
    set(AOCL_DLP_TARGET AoclDlp::aocl-dlp_static)
    message(STATUS "Using static AOCL-DLP library")
else()
    set(AOCL_DLP_TARGET AoclDlp::aocl-dlp)
    message(STATUS "Using shared AOCL-DLP library")
endif()

#
# Add a C example executable
#
# The examples are pure C while AOCL-DLP is C++, so CMake would derive the C
# driver from their sources. That driver contributes only the C half of the
# compiler's sanitizer runtime, whereas a sanitizer-instrumented build of the
# library deliberately leaves the C++ half's handlers (vptr, dynamic type cache)
# undefined for the final executable to supply - so a C-driver link either fails
# to resolve them or produces a binary that aborts at load.
#
# Parameters:
#   NAME    - Name of the example executable
#   SOURCES - Example source files
#
function(dlp_add_c_example)
    set(options "")
    set(oneValueArgs NAME)
    set(multiValueArgs SOURCES)

    cmake_parse_arguments(DLP_EXAMPLE "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(NOT DLP_EXAMPLE_NAME)
        message(FATAL_ERROR "dlp_add_c_example: NAME argument is required")
    endif()

    if(NOT DLP_EXAMPLE_SOURCES)
        message(FATAL_ERROR "dlp_add_c_example: SOURCES argument is required")
    endif()

    add_executable(${DLP_EXAMPLE_NAME} ${DLP_EXAMPLE_SOURCES})

    # Ask for the C++ driver only when C++ is available: this file may be added
    # as a subdirectory of a project that never enabled the language, and
    # demanding it there would fail the configure outright. list(FIND) rather
    # than IN_LIST because a parent supplies the policy scope in that case and
    # IN_LIST needs CMP0057 set to NEW.
    get_property(enabled_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    list(FIND enabled_languages CXX cxx_language_index)
    if(NOT cxx_language_index EQUAL -1)
        set_target_properties(${DLP_EXAMPLE_NAME} PROPERTIES LINKER_LANGUAGE CXX)
    endif()

    # Link with AOCL-DLP library (includes all necessary include directories)
    target_link_libraries(${DLP_EXAMPLE_NAME}
        PRIVATE
            ${AOCL_DLP_TARGET}
    )

    # Reuse the runtime selected by the installed AOCL-DLP package.
    if(AoclDlp_OPENMP_ENABLED AND TARGET AoclDlp::openmp)
        target_link_libraries(${DLP_EXAMPLE_NAME} PRIVATE AoclDlp::openmp)
        target_compile_definitions(
            ${DLP_EXAMPLE_NAME}
            PRIVATE
                DLP_EXAMPLE_ENABLE_OPENMP
                DLP_EXAMPLE_OPENMP_HAS_ACTIVE_LEVELS=${AoclDlp_OPENMP_HAS_ACTIVE_LEVELS}
                DLP_EXAMPLE_OPENMP_HAS_NESTING=${AoclDlp_OPENMP_HAS_NESTING}
        )
    endif()

    # Link with math library on Unix/Linux
    if(UNIX)
        target_link_libraries(${DLP_EXAMPLE_NAME} PRIVATE m)
    endif()
endfunction()

# Create an executable for each example source file
foreach(source ${EXAMPLE_SOURCES})
    # Extract the filename without extension
    get_filename_component(example_name ${source} NAME_WE)

    dlp_add_c_example(
        NAME ${example_name}
        SOURCES ${EXAMPLE_SOURCE_DIR}/${source}
    )

    message(STATUS "Added example: ${example_name}")
endforeach()

# Print build information
message(STATUS "")
message(STATUS "==========================================")
message(STATUS "AOCL-DLP Examples Configuration Summary")
message(STATUS "==========================================")
message(STATUS "AOCL-DLP Version: ${AoclDlp_VERSION}")
message(STATUS "Library Type: ${AOCL_DLP_TARGET}")
message(STATUS "Build Type: ${CMAKE_BUILD_TYPE}")
message(STATUS "C Compiler: ${CMAKE_C_COMPILER}")
message(STATUS "CXX Compiler: ${CMAKE_CXX_COMPILER}")
message(STATUS "==========================================")
message(STATUS "")
